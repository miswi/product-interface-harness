{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node product-interface-harness/adapters/claude/user-prompt.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node product-interface-harness/adapters/claude/stop.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
